# LocalLens environment variables.
# Copy to `.env` for local development; set via `fly secrets` in production.

# Required for the bot to start.
TELEGRAM_BOT_TOKEN=

# Required from Phase 6 (LLM responses) onward.
OPENAI_API_KEY=

# Required from Phase 4 (weather context) onward.
OPENWEATHERMAP_API_KEY=

# Required from Phase 9 (payment links) onward.
TOYYIBPAY_API_KEY=
TOYYIBPAY_CATEGORY_CODE=
# Defaults to the sandbox; flip to https://toyyibpay.com when going live.
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# Required from Phase 10 (webhook mode) onward — both must be set together.
# WEBHOOK_URL is the full public HTTPS URL the bot listens on (e.g., the
# Fly.io app URL + a path component). WEBHOOK_SECRET is a random string
# Telegram echoes back as the X-Telegram-Bot-Api-Secret-Token header so the
# bot can verify the request came from Telegram.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Port the bot binds to in webhook mode. Default 8080 (matches fly.toml).
PORT=8080

# `dev` (default) → long polling. `production` → webhook (Phase 10).
LL_MODE=dev

# Facebook Messenger integration (optional — leave blank to disable).
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
# Messenger webhook runs on PORT+1 (default 8081).

# Your personal Telegram user ID — receives handoff notifications from Messenger leads.
OWNER_TELEGRAM_USER_ID=
